{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run typecheck && npm run typecheck:scripts && npm run build && npm run test:dbtools && npm run test:admin-review && npm run test:historical-csv && npm run test:phase4 && npm run test:phase5 && npm run test:phase6",
    "test:phase1": "npm run typecheck:scripts && npm run test:dbtools",
    "test:admin-review": "tsx --test src/adminReview.test.ts",
    "test:integration:admin-review": "tsx --test src/adminReview.integration.test.ts",
    "test:integration:workspaces": "tsx src/test_workspaces_security.ts",
    "test:historical-csv": "tsx --test src/historicalCsv.test.ts",
    "test:phase4": "tsx --test src/phase4.test.ts",
    "test:integration:phase4": "tsx --test src/phase4.integration.test.ts",
    "test:phase5": "tsx --test src/phase5.test.ts",
    "test:phase6": "tsx --test src/phase6.test.ts",
    "test:integration:historical-admin": "tsx --test src/historicalAdmin.integration.test.ts",
    "test:integration:clean-bootstrap": "tsx --test scripts/db/clean_bootstrap.integration.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:test:create": "tsx scripts/db/create_test_db.ts",
    "db:verify-admin": "tsx scripts/verify_admin.ts",
    "test:dbtools": "tsx --test scripts/db/lib.test.ts scripts/db/baseline.test.ts"
  },
