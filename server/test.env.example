# Settings for the DISPOSABLE test database only. Copy these lines into server/.env
# (never commit .env). They are read ONLY by the db tooling and tests, never by the API.
#
# TEST_DB_NAME must match ^sauda_test_[a-z0-9_]+$ and must not be the same as DB_NAME.
# Use a throwaway MySQL account that can only touch sauda_test_* schemas.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=sauda_test_user
TEST_DB_PASSWORD=
TEST_DB_NAME=sauda_test_local

# Required opt-in for ANY destructive test/setup action (create/drop/apply drafts).
# Deliberately NOT set by default: enable it per run, e.g.  SAUDA_ALLOW_DESTRUCTIVE_TESTS=yes npm run db:test:create
# SAUDA_ALLOW_DESTRUCTIVE_TESTS=yes
# Only set to yes if the test database is intentionally on a non-local host.
# SAUDA_TEST_DB_ALLOW_REMOTE=yes
